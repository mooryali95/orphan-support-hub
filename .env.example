# نسخة مرجعية من متغيّرات البيئة — انسخها إلى .env.local وعبّئ القيم.
#
# القيم العامة (publishable) تعيش في .env المتتبَّع في Git لأن Vite يحقنها
# في حزمة المتصفّح على أي حال. أما الأسرار فتوضع في .env.local — وهو
# مُتجاهَل في .gitignore ويُحمَّل بأولوية أعلى — أو في متغيّرات بيئة
# Lovable Cloud مباشرةً.

# ── عام: يُحقن في حزمة المتصفّح ─────────────────────────────
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── أسرار: .env.local أو متغيّرات Lovable Cloud فقط ─────────
# لا تضع أياً من هذه في .env — سيُدفع إلى GitHub تلقائياً.
#
# يتجاوز RLS بالكامل. يُستخدم في webhooks الدفع وكتابة سجلّ المدفوعات
# والخط الزمني والإشعارات (المرحلتان 3 و4).
SUPABASE_SERVICE_ROLE_KEY=
# يحمي مسارات cron عبر src/integrations/supabase/cron-auth.ts (المرحلة 3).
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ── الدفع: Creem (creem.io) ─────────────────────────────────
# ملاحظة: المزوّد Creem وليس Careem — شركتان مختلفتان تماماً.
# التفاصيل الكاملة وخطوات الحصول على القيم في docs/payments-creem.ar.md
#
# يفعّل المزوّد. بلا هذا (أو بأسرار ناقصة) يرجع النظام للتحويل اليدوي.
PAYMENT_PROVIDER=
# مفتاح الواجهة. البادئة creem_test_ تختار نطاق الاختبار تلقائياً،
# فلا حاجة لمتغيّر بيئة منفصل يمكن أن يتناقض معه.
CREEM_API_KEY=
# سرّ توقيع الويبهوك — يُعرض مرّة واحدة عند إنشائه في لوحة Creem.
CREEM_WEBHOOK_SECRET=
# منتج متكرّر سعر وحدته 1.00 USD شهرياً. المبلغ الحقيقي يأتي من units،
# لأن custom_price لا يعمل مع المنتجات المتكرّرة.
CREEM_PRODUCT_MONTHLY=
# منتج دفعة واحدة (اختياري) — يقبل custom_price بالسنتات.
CREEM_PRODUCT_ONETIME=
# عملة المنتجَين أعلاه (الافتراض USD). كفالةٌ بعملةٍ أخرى تحتاج منتجاً لعملتها:
# CREEM_PRODUCT_MONTHLY_EUR / CREEM_PRODUCT_ONETIME_EUR … بسعر وحدةٍ واحدة،
# وإلا يُرفض دفعها الإلكتروني ويبقى التحويل البنكي.
CREEM_PRODUCT_CURRENCY=

# ── أصل المنصّة: المصدر الوحيد للروابط المطلقة ──────────────
# روابط البريد وإلغاء الاشتراك وخريطة الموقع والعودة من الدفع، مثل
# https://ioco.sunkvalue.com (بلا شرطة أخيرة). بلاه يتوقّف البريد ولا
# يُخترع نطاق. APP_ORIGIN اسمٌ قديم يُقبل احتياطاً فقط — لا تضبطه.
PUBLIC_BASE_URL=

# ── البريد المعامَلاتي: طريقٌ واحد عبر Lovable Email ─────────
# يضبطه Lovable Cloud عند ربط نطاق البريد. بلاه تصل الإشعارات داخل
# التطبيق، والبريد يبقى معلّقاً في الطابور حتى يُضبط.
# (RESEND_API_KEY وEMAIL_FROM أُزيلا: طريق Resend لم يعد موجوداً.)
LOVABLE_API_KEY=
# اختياري: نقطة إرسال بديلة لبيئة اختبار Lovable.
LOVABLE_SEND_URL=

# ── توقيع شهادات المنح (integrity.functions.ts) ────────────
GRANT_SIGNING_KEY=

# ── المراقبة (اختياري؛ بلا قيمةٍ لا يُرسل شيء) ──────────────
# السجلّ المنظَّم يذهب دائماً إلى سجلّات Workers (Logpush). وفوقه:
# يستقبل كلّ خطأ خادمٍ JSON بـPOST.
ERROR_REPORT_WEBHOOK_URL=
# أو Sentry (بلا SDK): https://<key>@<host>/<project>
SENTRY_DSN=
# نبض «الرجل الميّت» (healthchecks.io وما يشبهه): يُنقر بعد كلّ تشغيل،
# و<url>/fail عند الفشل. التفاصيل في docs/runbook.ar.md.
HEARTBEAT_URL_OPS=
HEARTBEAT_URL_DISPATCH=
HEARTBEAT_URL_RECONCILE=
HEARTBEAT_URL_RETENTION=
HEARTBEAT_URL_SECURITY=
# حدّ أحداث sec_* في الساعة قبل نقر نبض الفشل (50 افتراضاً)
SECURITY_EVENTS_THRESHOLD=
# مدّة استبقاء وسائط الطفل المؤرشَف بلا كفالة، بالأيام (≥30؛ الافتراض 365)
CHILD_UPDATES_ARCHIVE_DAYS=365
